name: CI

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

jobs:
  lint-test-build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: <app_folder>
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup <runtime, e.g. Node.js>
        uses: actions/setup-<runtime>@v4
        with:
          <runtime>-version: "<version>"

      - name: Install dependencies
        run: <install command>

      - name: Lint / analyze
        run: <analyze/lint command>

      - name: Test
        run: <test command>

      - name: Build
        run: <build command>
